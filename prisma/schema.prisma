generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(EDITOR)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  newsArticles NewsArticle[]
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

model Section {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   String   @db.Text
  pageGroup String
  sortOrder Int      @default(0)
  isVisible Boolean  @default(true)
  heroImage String?
  // URL pública donde se muestra la sección. Si es null, se asume /seccion/{slug}.
  // Las páginas con ruta propia (ej. /niveles/inicial) la setean explícitamente.
  navPath   String?
  // Etiqueta corta para el menú. Si es null, se usa `title`.
  navLabel  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Grupo del navbar. Las secciones se asocian por `Section.pageGroup == NavGroup.slug`.
// Reglas de render (ver src/lib/nav.ts):
//   - grupo no visible o sin items visibles  -> no aparece
//   - 1 item visible                          -> link directo
//   - 2+ items visibles                       -> dropdown
//   - `href` permite grupos que son páginas funcionales sin secciones (Noticias, Contacto)
model NavGroup {
  id        String   @id @default(cuid())
  slug      String   @unique
  label     String
  href      String?
  sortOrder Int      @default(0)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GalleryImage {
  id         String   @id @default(cuid())
  url        String
  publicId   String
  caption    String?
  album      String
  category   String   @default("institucional")
  sortOrder  Int      @default(0)
  uploadedAt DateTime @default(now())
}

model NewsArticle {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String
  content     String    @db.Text
  coverImage  String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
}

model SiteConfig {
  id              String  @id @default("main")
  schoolName      String  @default("Instituto Parroquial San Pablo Apóstol")
  phone           String  @default("")
  email           String  @default("")
  address         String  @default("")
  logoUrl         String?
  heroTitle       String  @default("")
  heroSubtitle    String  @default("")
  heroImageUrl    String?
  facebookUrl     String?
  instagramUrl    String?
  whatsappNumber  String?
  inscripcionOpen Boolean @default(false)
  inscripcionText String  @default("")
}

model HomeButton {
  id           String  @id @default(cuid())
  label        String
  fileUrl      String  @default("")
  downloadName String  @default("")
  color        String  @default("sky")
  sortOrder    Int     @default(0)
  isVisible    Boolean @default(true)
}

model StoredPdf {
  id        String   @id @default(cuid())
  fileName  String
  data      Bytes
  createdAt DateTime @default(now())
}
